# UdaraKu: variabel lingkungan
# =============================
# Salin file ini menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.
# SEMUA OPSIONAL: tanpa satu pun isian, aplikasi tetap berjalan penuh.
# Variabel berawalan NEXT_PUBLIC_ ikut tertanam ke kode peramban saat build, jadi
# JANGAN pernah menaruh rahasia di sana. Ubah nilainya = build ulang (redeploy).

# --- Identitas situs (SEO, Open Graph, sitemap) ---------------------------------
# Alamat lengkap situs tanpa garis miring di akhir, mis. https://udaraku.id
# Kosong = di Vercel dipakai domain produksi otomatis (VERCEL_PROJECT_PRODUCTION_URL),
# lalu alamat deployment, lalu http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Kontak pengelola (halaman Tentang & Metodologi, bagian privasi) ------------
# WAJIB diisi sebelum rilis publik: UU PDP meminta pengguna tahu siapa yang
# bisa dihubungi. Kosong = halaman Tentang menulis "Kontak pengelola belum diatur".
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Titik panas kebakaran NASA FIRMS (halaman Peta) ----------------------------
# Kunci gratis: https://firms.modaps.eosdis.nasa.gov/api/area/
# Hanya dibaca server (tanpa NEXT_PUBLIC_), tidak pernah dikirim ke peramban.
# Kosong = tombol "Titik panas" disembunyikan dan /api/firms membalas 404.
FIRMS_MAP_KEY=

# --- Video halaman Edukasi ------------------------------------------------------
# ID 11 karakter dari tautan YouTube (youtube.com/watch?v=ID).
# Kosong = kartu video menampilkan "Segera hadir".
NEXT_PUBLIC_EDU_YOUTUBE_ID=

# --- Hanya untuk pengujian (jangan diisi di produksi) ---------------------------
# Mengalihkan permintaan data ke server tiruan. Kosong = alamat resmi Open-Meteo / NASA.
# OPEN_METEO_AIR_URL=http://127.0.0.1:4010/air
# OPEN_METEO_WEATHER_URL=http://127.0.0.1:4010/weather
# FIRMS_API_URL=http://127.0.0.1:4010/firms